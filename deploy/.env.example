# Copy to deploy/.env. Never commit .env.

# Login name and password hash (not the password) for the chat.
# Make the hash with:  docker run --rm -it caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=''

# ":80" = plain HTTP on the ports below. A domain name, e.g. docs.example.com, = HTTPS.
# SITE_ADDRESS=:80
# HTTP_PORT=80
# HTTPS_PORT=443
# BIND_ADDRESS=0.0.0.0           # 127.0.0.1 to keep it off the network (tests)

# Folder with the client's documents, relative to deploy/.
# DOCS_PATH=./docs
# COMPANY_NAME=PawPantry
# ADMIN_TOKEN=                   # protects POST /ingest; leave empty if you only use the CLI
# QUESTION_LOG_PATH=             # set empty to switch the question log off
