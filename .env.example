# Copy to .env and fill in. Never commit .env.

# --- Providers -----------------------------------------------------------------
OPENAI_API_KEY=
# LLM_PROVIDER=openai            # openai | anthropic
# LLM_MODEL=gpt-4.1-mini         # or gpt-4o-mini; for anthropic e.g. claude-haiku-5-5
# ANTHROPIC_API_KEY=             # only when LLM_PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai      # openai | hashing (offline, lexical, for demos/tests)
# EMBEDDING_MODEL=text-embedding-3-small
# REQUEST_TIMEOUT_S=30

# --- Knowledge base ------------------------------------------------------------
# COMPANY_NAME=PawPantry
# DOCS_DIR=data/docs
# INDEX_PATH=data/index.sqlite
# CHUNK_MAX_CHARS=1200
# CHUNK_OVERLAP_CHARS=200

# --- Retrieval & generation ----------------------------------------------------
# TOP_K=5
# MIN_SIMILARITY=0.30            # relevance gate; below it the assistant refuses without an LLM call
# HYBRID_SEARCH=true             # vector + BM25 with reciprocal rank fusion
# MAX_ANSWER_TOKENS=500
# TEMPERATURE=0

# --- Operations ----------------------------------------------------------------
# ADMIN_TOKEN=                   # if set, POST /ingest requires header X-Admin-Token
# USAGE_LOG_PATH=                # JSONL log of token usage per paid call (no prompts, no keys)
# QUESTION_LOG_PATH=             # JSONL log of the questions asked (personal data possible; off when empty)
